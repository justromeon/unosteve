# App
PORT=8080

# Postgres
DATABASE_URL=postgresql://127.0.0.1:5432/unosteve?sslmode=disable
TEST_DATABASE_URL=postgresql://127.0.0.1:5432/unosteve_test?sslmode=disable

# `dbmate (migrations)
DBMATE_NO_DUMP_SCHEMA=true

# Object storage (S3 API; Cloudflare R2)
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=unosteve-dev
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Logging (optional, default: info) — debug | info | warn | error
LOG_LEVEL=debug

# Sessions (optional, in seconds)
# End a session after this long without use. Default: 604800 (7 days).
SESSION_TTL=604800
# End a session this long after login, however active it is. Default: 2592000 (30 days).
SESSION_MAX_AGE=2592000
