cabal-version:   3.4
name:            unosteve
version:         0.1.0.0

-- synopsis:
-- description:
license:         BSD-3-Clause
license-file:    LICENSE
author:          Justin Kian Romeon
maintainer:      romeonjustin@gmail.com

-- copyright:
category:        Web
build-type:      Simple
extra-doc-files: CHANGELOG.md

-- extra-source-files:

common shared
  default-language:   GHC2021
  ghc-options:        -Wall
  default-extensions:
    DataKinds
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    OverloadedRecordDot
    OverloadedStrings

  build-depends:
    , base            ^>=4.20.2.0
    , servant-server
    , text

library
  import:          shared
  exposed-modules:
    UnoSteve.Api
    UnoSteve.Api.Auth
    UnoSteve.Auth
    UnoSteve.Clock
    UnoSteve.Clock.Fixed
    UnoSteve.Clock.Settable
    UnoSteve.Clock.System
    UnoSteve.Config
    UnoSteve.Database
    UnoSteve.Database.Sessions
    UnoSteve.Database.Users
    UnoSteve.Domain.Node
    UnoSteve.Domain.Page
    UnoSteve.Domain.Password
    UnoSteve.Domain.Session
    UnoSteve.Domain.User
    UnoSteve.Env
    UnoSteve.Logger
    UnoSteve.Logger.Collecting
    UnoSteve.Logger.Noop
    UnoSteve.Logger.Stdout
    UnoSteve.PasswordHasher
    UnoSteve.Secret
    UnoSteve.Sessions

  -- other-modules:
  -- other-extensions:
  build-depends:
    , aeson
    , bytestring
    , containers
    , crypton
    , hasql          ^>=1.9
    , hasql-pool     ^>=1.3
    , hasql-th       ^>=0.4
    , http-api-data
    , http-types
    , memory
    , password
    , profunctors
    , time
    , uuid
    , wai
    , wai-extra

  hs-source-dirs:  src

executable unosteve
  import:         shared
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  main-is:        Main.hs

  -- other-modules:
  -- other-extensions:
  build-depends:
    , unosteve
    , warp

  hs-source-dirs: app

test-suite unosteve-test
  import:         shared
  other-modules:
    Test.Support
    UnoSteve.ApiSpec
    UnoSteve.AuthSpec
    UnoSteve.Database.UsersSpec
    UnoSteve.Domain.NodeSpec
    UnoSteve.Domain.PageSpec
    UnoSteve.Domain.PasswordSpec
    UnoSteve.Domain.UserSpec
    UnoSteve.LoggerSpec
    UnoSteve.PasswordHasherSpec
    UnoSteve.SessionsSpec

  -- other-extensions:
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , bytestring
    , hasql          ^>=1.9
    , hspec
    , hspec-wai      ^>=0.11
    , http-api-data
    , http-types
    , time
    , unosteve
    , uuid
    , wai
    , wai-extra
